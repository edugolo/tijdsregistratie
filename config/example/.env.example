# Example configuration. Copy to `.env` (never commit that file) and adjust.
# All variables are read by the web app; the admin CLI reads the ones marked (admin).
# Booleans accept: true, false, 1, 0.

# --- Required ------------------------------------------------------------

# PostgreSQL connection string (app, admin). With the compose file the host is `db`.
DATABASE_URL=postgres://tijd:change-me@db:5432/tijd

# Public origin of the deployment as scheme://host[:port], no path (app, admin: used for
# enrollment links). A path is refused at startup; the default port and a trailing slash are dropped.
# WARNING: passkeys are bound to this domain. Changing it later invalidates every passkey.
APP_ORIGIN=https://tijd.example.org

# Files with the encryption keys (app, admin). Create them with `admin generate-key`.
# Inside the container the compose file mounts them from ./secrets/ at /run/secrets/.
DATA_KEY_FILE=/run/secrets/data_key
BLIND_INDEX_KEY_FILE=/run/secrets/blind_index_key

# --- Optional ------------------------------------------------------------

# WebAuthn relying party id. Defaults to the host of APP_ORIGIN; leave it unset unless you
# know you need a parent domain. Also bound to every passkey.
#RP_ID=tijd.example.org

# Session cookie `Secure` flag. Must be true for an https APP_ORIGIN (default: true).
# Set to false only for plain-http local testing.
#COOKIE_SECURE=true

# Address and port the server binds to. The container image sets IP=0.0.0.0 and PORT=8080;
# outside a container the default is 127.0.0.1:8080.
#IP=0.0.0.0
#PORT=8080

# Read the client address from X-Forwarded-For. Enable ONLY behind a reverse proxy that
# overwrites the header and is the sole way to reach the app (default: false).
#TRUST_PROXY_HEADERS=false

# Requests per minute and client address on /api/auth/* (default: 60; schools share one NAT
# address). Failed sign-in attempts (10 per 10 minutes) and /api/setup/* (10 per minute) have
# their own stricter, fixed limits.
#AUTH_RATE_LIMIT_PER_MINUTE=60

# --- Compose only --------------------------------------------------------

# Used by deploy/compose.yaml for the db service and to build DATABASE_URL above.
POSTGRES_USER=tijd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tijd
# Host port the app is published on (bound to 127.0.0.1; the reverse proxy connects here).
HOST_PORT=8080
# User and group id the app runs as. The key files in ./secrets/ must be readable by this
# id. Default 10001 (the image user). With 0600 key files owned by your host user: on regular
# Docker set your own `id -u` / `id -g`; on rootless Docker set 0 and 0 (maps to your host user).
#APP_UID=10001
#APP_GID=10001
